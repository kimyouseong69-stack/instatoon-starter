# 이 파일을 복사해서 .env 를 만드세요:  cp .env.example .env
# .env 는 .gitignore 로 막혀 있어 깃허브에 올라가지 않습니다. 값은 절대 남에게 보내지 마세요.

# (선택) AI로 그림 뽑을 때 — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# (선택) 인스타 자동 업로드 — docs/02_인스타_API_연결.md 대로 발급
IG_ACCESS_TOKEN=

# (선택) 업로드 파일을 Cloudflare R2 로 띄울 때만 (기본은 임시 터널이라 비워 둬도 됨)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=
